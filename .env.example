# ── Required ─────────────────────────────────────────────────────────
# Postgres connection string (Railway/Render/Supabase/etc.)
# On Railway, add a Postgres service and reference it as: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@host:5432/rentpayez

# Set to "false" only if your Postgres provider doesn't need SSL (e.g. local dev)
PGSSL=true

# Long random string — used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Railway injects PORT automatically — this fallback is only used for local dev
PORT=4000
NODE_ENV=production

# ── Optional: online rent payments ──────────────────────────────────
# Leave unset and the app degrades gracefully (a clear "not set up yet"
# message instead of an error) — no code changes needed either way.
STRIPE_SECRET_KEY=sk_live_or_sk_test_your_key_here

# ── Optional: tenant Credit tab "Coach" chat + maintenance auto-translate ──
# Either provider works; set one or the other (or both). Leave both unset
# and those two features degrade gracefully (503 / untranslated fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_COACH_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# ── Optional: only used by local operator scripts (scripts/seed-demo.js,
# scripts/add-landlord.js) to know which server to talk to — never read
# by the running app itself, so it has no effect on production behavior.
BASE_URL=http://localhost:4000
